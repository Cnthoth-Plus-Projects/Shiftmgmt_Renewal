{
  "name": "shiftmgmt",
  "version": "0.1.0",
  "private": true,
  "description": "교대근무관리 시스템 — 한 대의 PC에 설치하는 작은 프로그램(로컬 서버 + 크롬 화면)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:browser && node scripts/copy-web-assets.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:browser": "esbuild src/web/app.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/browser/web/app.js --sourcemap --log-level=warning",
    "start": "node dist/server/main/server.js",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.browser.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "validate:map": "node scripts/validate-codebase-map.mjs",
    "release:check": "node scripts/release-check.mjs",
    "capture": "node scripts/capture-screen.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "esbuild": "^0.27",
    "eslint": "^9",
    "globals": "^15",
    "material-symbols": "^0.45",
    "playwright": "^1.58",
    "pretendard": "^1.3",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vitest": "^3.2"
  }
}
